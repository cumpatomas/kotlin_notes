                  "id": "adoption_basic_info_v1",
                  "validateOn": ["blur", "submit"],
                  "layout": {
                    "fieldHeight": 52,
                    "labelToFieldGap": 8,
                    "fieldToHelperGap": 4,
                    "fieldToFieldGap": 24,
                    "buttonHeight": 56,
                    "inputHorizontalPadding": 16,
                    "inputVerticalPadding": 14,
                    "fieldCornerRadius": 16,
		    "paddingTop": 8
                  },
                  "fields": [
                    {
                      "id": "otherPets",
                      "type": "text",
                      "label": "¿Tienes otras mascotas? ¿Cuáles?",
                      "placeholder": "Indica la respuesta",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100,
			"paddingTop": 0
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "homeType",
                      "type": "text",
                      "label": "¿Vives en un piso o una casa?",
                      "placeholder": "Piso o casa",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "ownershipType",
                      "type": "text",
                      "label": "¿Vives alquilado/a o eres propietario/a?",
                      "placeholder": "Alquiler o propiedad",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "outdoorSpace",
                      "type": "text",
                      "label": "¿Tienes patio o espacio al aire libre?",
                      "placeholder": "Sí o no",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "adoptionReason",
                      "type": "text",
                      "label": "¿Por qué quieres adoptar una mascota?",
                      "placeholder": "Ejemplo: Necesito compañía",
                      "layout": {
                        "height": 108,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "coverCosts",
                      "type": "text",
                      "label": "¿Estás dispuesto/a a cubrir gastos veterinarios, alimentación y otros cuidados?",
                      "placeholder": "Sí o no",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    },
                    {
                      "id": "travelPlan",
                      "type": "text",
                      "label": "Si vas de viaje, ¿qué harás con el animal?",
                      "placeholder": "Indica la respuesta",
                      "layout": {
                        "height": 52,
                        "widthPercentage": 100
                      },
                      "styles": {
                        "backgroundColor": "#FFFFFF",
                        "borderColor": "#E5DFDA",
                        "borderWidth": 1,
                        "textColor": "#1A1A1A",
                        "labelColor": "#1A1A1A",
                        "helperColor": "#FF745C",
                        "cornerRadius": 16
                      }
                    }
                  ],
                   "submit": {
                  "label": "Siguiente",
                  "action": {
                    "type": "next",
                    "url": "https://raw.githubusercontent.com/cumpatomas/kotlin_notes/refs/heads/dynamic-forms/form2.json"
                  }
                }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
