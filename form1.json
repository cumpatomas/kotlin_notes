{
  "schemaVersion": "1.0",
  "responsiveLayouts": [
    {
      "minWidth": 320,
      "dimensions": {
        "width": 375,
        "height": 812
      },
      "componentTree": {
        "id": "adoption-basic-info-screen",
        "componentType": "container",
        "direction": "vertical",
        "spacing": 0,
        "styles": {
          "backgroundColor": "#FFFFFF"
        },
        "positioning": {
          "widthPercentage": 100,
          "heightPercentage": 100,
          "paddingTop": 24,
          "paddingBottom": 24,
          "paddingStart": 20,
          "paddingEnd": 20,
          "verticalAlignment": "start",
          "horizontalAlignment": "start"
        },
        "children": [
          {
            "id": "screen-title",
            "componentType": "text",
            "textContent": "Formulario",
            "styles": {
              "fontSize": 24,
              "fontWeight": 600,
              "color": "#1A1A1A"
            },
            "positioning": {
              "widthPercentage": 100,
              "paddingTop": 0,
              "paddingBottom": 20,
              "paddingStart": 0,
              "paddingEnd": 0,
              "horizontalAlignment": "center"
            }
          },
          {
            "id": "step-indicator",
            "componentType": "container",
            "direction": "vertical",
            "spacing": 8,
            "positioning": {
              "widthPercentage": 100,
              "paddingTop": 0,
              "paddingBottom": 20,
              "paddingStart": 0,
              "paddingEnd": 0
            },
            "children": [
              {
                "id": "step-bars-row",
                "componentType": "container",
                "direction": "horizontal",
                "spacing": 12,
                "positioning": {
                  "widthPercentage": 100
                },
                "children": [
                  {
                    "id": "step-bar-active",
                    "componentType": "container",
                    "direction": "vertical",
                    "styles": {
                      "backgroundColor": "#FF745C"
                    },
                    "positioning": {
                      "widthPercentage": 48,
                      "paddingTop": 4,
                      "paddingBottom": 4,
                      "paddingStart": 0,
                      "paddingEnd": 0
