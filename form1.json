                    "positioning": {
                      "widthPercentage": 48,
                      "paddingTop": 4,
                      "paddingBottom": 4,
                      "paddingStart": 0,
                      "paddingEnd": 0
                    },
                    "children": [
                      {
                        "id": "step-bar-inactive-spacer",
                        "componentType": "text",
                        "textContent": " ",
                        "styles": {
                          "fontSize": 1,
                          "color": "#F0ECE9"
                        },
                        "positioning": {
                          "widthPercentage": 100,
                          "horizontalAlignment": "center"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "step-labels-row",
                "componentType": "container",
                "direction": "horizontal",
                "spacing": 12,
                "positioning": {
                  "widthPercentage": 100
                },
                "children": [
                  {
                    "id": "step-label-active",
                    "componentType": "text",
                    "textContent": "Información básica",
                    "styles": {
                      "fontSize": 14,
                      "fontWeight": 400,
                      "color": "#FF745C"
                    },
                    "positioning": {
                      "widthPercentage": 48
                    }
                  },
                  {
                    "id": "step-label-inactive",
                    "componentType": "text",
                    "textContent": "Datos personales",
                    "styles": {
                      "fontSize": 14,
                      "fontWeight": 400,
                      "color": "#D5CFCB"
                    },
                    "positioning": {
                      "widthPercentage": 48
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "intro-copy",
            "componentType": "text",
            "textContent": "Para solicitar este animal debes rellenar el formulario. La protectora se pondrá en contacto contigo con la mayor brevedad posible.",
            "styles": {
              "fontSize": 16,
              "fontWeight": 400,
              "color": "#1A1A1A"
            },
            "positioning": {
              "widthPercentage": 100,
              "paddingTop": 0,
              "paddingBottom": 24,
              "paddingStart": 0,
              "paddingEnd": 0
            }
          },
          {
            "id": "scrollable-body",
            "componentType": "container",
            "direction": "vertical",
            "spacing": 0,
            "behavior": {
              "scroll": {
                "enabled": true,
                "axis": "vertical",
                "showsIndicators": false
              }
            },
            "positioning": {
              "widthPercentage": 100,
              "grow": 1,
              "paddingTop": 0,
              "paddingBottom": 0,
              "paddingStart": 0,
              "paddingEnd": 0
            },
            "children": [
              {
                "id": "adoption-form",
