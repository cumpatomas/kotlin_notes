                    "children": [
                      {
                        "id": "step-bar-active-spacer",
                        "componentType": "text",
                        "textContent": " ",
                        "styles": {
                          "fontSize": 1,
                          "color": "#FF745C"
                        },
                        "positioning": {
                          "widthPercentage": 100,
                          "horizontalAlignment": "center"
                        }
                      }
                    ]
                  },
                  {
                    "id": "step-bar-inactive",
                    "componentType": "container",
                    "direction": "vertical",
                    "styles": {
                      "backgroundColor": "#F0ECE9"
